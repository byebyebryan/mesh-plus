    {
      "type": "object",
      "properties": {
        "registryProtocol": {
          "const": "mesh-plus.endpoints-candidate.v1"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "endpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "product": {
          "enum": [
            "state",
            "events"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "authRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "backend": {
          "const": "ipc"
        },
        "address": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "registryProtocol",
        "revision",
        "endpointId",
        "hostId",
        "sourceId",
        "product",
        "profile",
        "authRef",
        "backend",
        "address"
      ],
      "additionalProperties": false
    },
