{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmux-observer.invalid/contracts/service-v1/schema.json",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "tmux-observer.service.v1"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "status",
        "view",
        "heartbeat",
        "gap",
        "resync",
        "error",
        "refresh_result"
      ]
    },
    "publisherId": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source": {
      "$ref": "https://tmux-observer.invalid/contracts/observation-v1/schema.json#/$defs/Source"
    },
    "clock": {
      "$ref": "https://tmux-observer.invalid/contracts/observation-v1/schema.json#/$defs/Clock"
    },
    "encodedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "viewRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "receipt": {
      "$ref": "https://tmux-observer.invalid/contracts/service-v1/schema.json#/$defs/Receipt"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "https://tmux-observer.invalid/contracts/observation-v1/schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://tmux-observer.invalid/contracts/observation-v1/schema.json#/$defs/Error"
        },
        {
          "type": "null"
        }
      ]
    },
    "ticket": {
      "anyOf": [
        {
          "$ref": "https://tmux-observer.invalid/contracts/service-v1/schema.json#/$defs/Ticket"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "schemaVersion",
    "kind",
    "publisherId",
    "source",
    "clock",
    "encodedAt",
    "sequence",
    "viewRevision",
    "receipt",
    "snapshot",
    "requestId",
    "error",
    "ticket"
  ],
  "additionalProperties": true,
  "$defs": {
    "Receipt": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "warming",
            "ready",
            "failed",
            "unsupported",
            "expired"
          ]
        },
        "attempted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "acceptedAttempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "lastAttemptAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "lastAttemptResult": {
          "type": "string",
          "enum": [
            "none",
            "complete",
            "partial",
            "failed",
            "unsupported"
          ]
        },
        "leaseMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "remainingMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "inFlight": {
          "type": "boolean"
        }
      },
      "required": [
        "state",
        "attempted",
        "accepted",
        "acceptedAttempt",
        "startedAt",
        "acceptedAt",
        "expiresAt",
        "lastAttemptAt",
        "lastAttemptResult",
        "leaseMs",
        "remainingMs",
        "inFlight"
      ],
      "additionalProperties": true
    },
    "Ticket": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "publisherId": {
          "type": "string",
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "accepted",
            "coalesced",
            "running",
            "complete",
            "failed",
            "stale_scope",
            "deadline"
          ]
        },
        "requestedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "deadlineAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "maxLength": 16384,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "owner",
                  "desktop"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "complete",
                  "failed",
                  "stale_scope",
                  "deadline"
                ]
              },
              "attempt": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "$ref": "https://tmux-observer.invalid/contracts/observation-v1/schema.json#/$defs/Error"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "hostId",
              "source",
              "state",
              "attempt",
              "error"
            ],
            "additionalProperties": true
          },
          "maxItems": 32,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "publisherId",
        "state",
        "requestedAt",
        "deadlineAt",
        "sources"
      ],
      "additionalProperties": true
    }
  }
}
