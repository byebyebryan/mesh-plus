{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-plus:delivery:candidate:1:digest-proof",
  "type": "object",
  "properties": {
    "kind": {
      "const": "digest-proof"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{32,64}$"
    },
    "ownerDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hostId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "ownerEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "clock": {
      "type": "object",
      "properties": {
        "bootId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "timeNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^time:[0-9]+$"
        }
      },
      "required": [
        "bootId",
        "timeNamespace"
      ],
      "additionalProperties": false
    },
    "evaluatedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "health": {
            "enum": [
              "current",
              "partial",
              "stale",
              "warming",
              "unavailable"
            ]
          },
          "accepted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "originalExpiryMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "remainingMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sourceId",
          "component",
          "health",
          "accepted",
          "originalExpiryMs",
          "remainingMs"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "kind",
    "nonce",
    "ownerDigest",
    "hostId",
    "sourceId",
    "ownerEpoch",
    "clock",
    "evaluatedAtMs",
    "receipts"
  ],
  "additionalProperties": false
}
