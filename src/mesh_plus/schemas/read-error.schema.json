{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mesh-plus:read:1:error",
  "type": "object",
  "properties": {
    "meshProtocol": {
      "const": 1
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{32,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "meshProtocol",
    "requestId",
    "error"
  ],
  "additionalProperties": false
}
